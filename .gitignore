# This git repository publishes only the iPhone app, the shared spec it is tested against, and CI.
# Everything else in dorme_platform (Pi coordinator, deploy files, reports) stays local.
/*
!/.gitignore
!/.github/
!/ios/
!/spec/
# Generated or local
ios/DORME.xcodeproj/
ios/**/.build/
ios/**/.swiftpm/
*.p8
*.mobileprovision
*.p12
.DS_Store
