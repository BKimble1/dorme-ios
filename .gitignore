# This git repository publishes the iPhone app, the shared spec, CI, and the robot's coordinator package
# (no secrets in any of them). Deploy files, tests needing the robot, and reports stay local.
/*
!/.gitignore
!/.github/
!/ios/
!/spec/
# The robot's server package and the codec copy it needs, so CI can run it in simulator mode (2026-11-25).
!/pi/
/pi/*
!/pi/dorme_coord/
!/pi/vendor/
# Generated or local
ios/DORME.xcodeproj/
ios/**/.build/
ios/**/.swiftpm/
*.p8
*.mobileprovision
*.p12
.DS_Store
__pycache__/
